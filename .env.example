# AI_PROVIDER=openai | anymodel | openrouter
AI_PROVIDER=openai
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=your_available_openai_model_here
OPENAI_REASONING_EFFORT=low
# AnyModel: set AI_PROVIDER=anymodel. To switch Qwen/Gemini/GPT change only ANYMODEL_MODEL.
ANYMODEL_API_KEY=your_anymodel_api_key_here
ANYMODEL_BASE_URL=https://anymodel.org/v1
ANYMODEL_MODEL=qwen/qwen3.7-max
LLM_TIMEOUT_MS=50000
# OpenRouter (free Qwen): set AI_PROVIDER=openrouter
# AI_PROVIDER=openrouter
OPENROUTER_API_KEY=
OPENROUTER_MODEL=qwen/qwen3-235b-a22b:free
MESSAGE_BUFFER_MS=4000
WEB_CHAT_FOLLOWUP_SILENCE_MS=60000
MAX_HISTORY_MESSAGES=40
PORT=3000
MANAGER_PHONE=77077471301
MANAGER_CHAT_ID=77077471301@c.us
GREEN_API_INSTANCE_ID=
GREEN_API_TOKEN=
TELEGRAM_BOT_TOKEN=
